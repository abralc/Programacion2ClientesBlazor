@page "/clientes"
@using Programacion2ClientesBlazor.Models
@using Programacion2ClientesBlazor.Services
@inject ClienteService ClienteService

<PageTitle>Administración de Clientes</PageTitle>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Administración de Clientes</h2>
            <p class="text-muted mb-0">
                Gestión de clientes registrados en el sistema.
            </p>
        </div>

        <button class="btn btn-primary"
                @onclick="AbrirModalNuevo">
            + Nuevo cliente
        </button>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @claseMensaje alert-dismissible fade show"
             role="alert">

            @mensaje

            <button type="button"
                    class="btn-close"
                    @onclick="CerrarMensaje">
            </button>
        </div>
    }

    @if (cargando)
    {
        <div class="text-center py-5">

            <div class="spinner-border text-primary"
                 role="status">
            </div>

            <div class="mt-3">
                Cargando clientes...
            </div>

        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>CUI</th>
                                <th>NIT</th>
                                <th>Cliente</th>
                                <th>Dirección</th>
                                <th>Teléfono</th>
                                <th>Fecha nacimiento</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (clientes.Count == 0)
                            {
                                <tr>
                                    <td colspan="8"
                                        class="text-center text-muted py-4">

                                        No hay clientes registrados.

                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in clientes)
                                {
                                    <tr>

                                        <td>@item.Id_cliente</td>

                                        <td>@item.CUI</td>

                                        <td>@item.NIT</td>

                                        <td>
                                            @item.Nombres @item.Apellidos
                                        </td>

                                        <td>@item.Direccion</td>

                                        <td>@item.Telefono</td>

                                        <td>
                                            @item.Fecha_Nacimiento.ToString("dd/MM/yyyy")
                                        </td>

                                        <td class="text-end">

                                            <button class="btn btn-sm btn-outline-primary me-2"
                                                    @onclick="() => AbrirModalEditar(item)">
                                                Editar
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => AbrirModalEliminar(item)">
                                                Eliminar
                                            </button>

                                        </td>

                                    </tr>
                                }
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
</div>


@if (mostrarModalCliente)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content">

                <EditForm Model="clienteActual"
                          OnValidSubmit="GuardarCliente">

                    <DataAnnotationsValidator />

                    <div class="modal-header">

                        <h5 class="modal-title">

                            @if (esEdicion)
                            {
                                <span>Modificar cliente</span>
                            }
                            else
                            {
                                <span>Nuevo cliente</span>
                            }

                        </h5>

                        <button type="button"
                                class="btn-close"
                                @onclick="CerrarModalCliente">
                        </button>

                    </div>

                    <div class="modal-body">

                        @if (!string.IsNullOrEmpty(mensajeModal))
                        {
                            <div class="alert @claseMensajeModal alert-dismissible fade show mb-3"
                                 role="alert">
                                @mensajeModal
                                <button type="button"
                                        class="btn-close"
                                        @onclick="CerrarMensajeModal">
                                </button>
                            </div>
                        }

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    CUI *
                                </label>

                                <InputText class="form-control"
                                        @bind-Value="clienteActual.CUI"
                                        maxlength="13"
                                        inputmode="numeric"
                                        autocomplete="off"
                                        oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,13)" />

                                <ValidationMessage For="@(() => clienteActual.CUI)" />

                                <div class="form-text">
                                    Exactamente 13 dígitos.
                                </div>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    NIT *
                                </label>

                                <InputText class="form-control text-uppercase"
                                        @bind-Value="clienteActual.NIT"
                                        maxlength="11"
                                        autocomplete="off"
                                        oninput="
                                            this.value = this.value
                                                .toUpperCase()
                                                .replace(/[^0-9K-]/g, '')
                                                .replace(/K(?!$)/g, '')
                                                .slice(0, 11)
                                        " />

                                <ValidationMessage For="@(() => clienteActual.NIT)" />

                                <div class="form-text">
                                    Ejemplos: 12345678, 123456789, 1234567-8 o 1234567-K.
                                </div>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Nombres *
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.Nombres" />

                                <ValidationMessage For="@(() => clienteActual.Nombres)" />

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Apellidos *
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.Apellidos" />

                                <ValidationMessage For="@(() => clienteActual.Apellidos)" />

                            </div>

                            <div class="col-md-12">

                                <label class="form-label">
                                    Dirección
                                </label>

                                <InputText class="form-control"
                                           @bind-Value="clienteActual.Direccion" />

                                <ValidationMessage For="@(() => clienteActual.Direccion)" />

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Teléfono
                                </label>

                                <InputText class="form-control"
                                        @bind-Value="clienteActual.Telefono"
                                        maxlength="8"
                                        inputmode="numeric"
                                        autocomplete="off"
                                        oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,8)" />

                                <ValidationMessage For="@(() => clienteActual.Telefono)" />

                                <div class="form-text">
                                    Exactamente 8 dígitos.
                                </div>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label">
                                    Fecha de nacimiento *
                                </label>

                                <InputDate class="form-control"
                                           @bind-Value="clienteActual.Fecha_Nacimiento"
                                           max="@FechaMaxima" />

                                <ValidationMessage For="@(() => clienteActual.Fecha_Nacimiento)" />

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                @onclick="CerrarModalCliente">

                            Cancelar

                        </button>

                        <button type="submit"
                                class="btn btn-primary"
                                disabled="@guardando">

                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <span>Guardar</span>
                            }

                        </button>

                    </div>

                </EditForm>

            </div>

        </div>

    </div>
}


@if (mostrarModalEliminar && clienteEliminar != null)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         style="background-color: rgba(0,0,0,.5);">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Confirmar eliminación
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CerrarModalEliminar">
                    </button>

                </div>

                <div class="modal-body">

                    <p class="mb-0">

                        ¿Deseas eliminar al cliente

                        <strong>
                            @clienteEliminar.Nombres
                            @clienteEliminar.Apellidos
                        </strong>?

                    </p>

                </div>

                <div class="modal-footer">

                    <button class="btn btn-secondary"
                            @onclick="CerrarModalEliminar">

                        Cancelar

                    </button>

                    <button class="btn btn-danger"
                            disabled="@eliminando"
                            @onclick="EliminarCliente">

                        @if (eliminando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Eliminando...</span>
                        }
                        else
                        {
                            <span>Eliminar</span>
                        }

                    </button>

                </div>

            </div>

        </div>

    </div>
}


@code {

    private List<Cliente> clientes = new();

    private Cliente clienteActual = new();

    private Cliente? clienteEliminar;

    private bool cargando = true;

    private bool guardando = false;

    private bool eliminando = false;

    private bool mostrarModalCliente = false;

    private bool mostrarModalEliminar = false;

    private bool esEdicion = false;

    private string mensaje = string.Empty;

    private string claseMensaje = "alert-success";

    private string mensajeModal = string.Empty;

    private string claseMensajeModal = "alert-danger";

    private string FechaMaxima => DateTime.Today.ToString("yyyy-MM-dd");


    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }


    private async Task CargarClientes()
    {
        try
        {
            cargando = true;

            clientes =
                await ClienteService.ObtenerClientesAsync();
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error al cargar clientes: {ex.Message}",
                "alert-danger"
            );
        }
        finally
        {
            cargando = false;
        }
    }


    private void AbrirModalNuevo()
    {
        CerrarMensajeModal();

        clienteActual = new Cliente
        {
            Fecha_Nacimiento = DateTime.Today
        };

        esEdicion = false;

        mostrarModalCliente = true;
    }


    private void AbrirModalEditar(Cliente cliente)
    {
        CerrarMensajeModal();

        clienteActual = new Cliente
        {
            Id_cliente = cliente.Id_cliente,
            CUI = cliente.CUI,
            NIT = cliente.NIT,
            Nombres = cliente.Nombres,
            Apellidos = cliente.Apellidos,
            Direccion = cliente.Direccion,
            Telefono = cliente.Telefono,
            Fecha_Nacimiento = cliente.Fecha_Nacimiento
        };

        esEdicion = true;

        mostrarModalCliente = true;
    }


    private void CerrarModalCliente()
    {
        mostrarModalCliente = false;
        CerrarMensajeModal();
    }


    private async Task GuardarCliente()
    {
        try
        {
            guardando = true;

            ResultadoOperacion resultado;

            if (esEdicion)
            {
                resultado =
                    await ClienteService.ActualizarClienteAsync(clienteActual);
            }
            else
            {
                resultado =
                    await ClienteService.CrearClienteAsync(clienteActual);
            }

            if (resultado.Exito)
            {
                mostrarModalCliente = false;

                await CargarClientes();

                MostrarMensaje(
                    resultado.Mensaje,
                    "alert-success"
                );
            }
            else
            {
                MostrarMensajeModal(
                    resultado.Mensaje,
                    "alert-danger"
                );
            }
        }
        catch (Exception ex)
        {
            MostrarMensajeModal(
                $"Error al guardar: {ex.Message}",
                "alert-danger"
            );
        }
        finally
        {
            guardando = false;
        }
    }


    private void AbrirModalEliminar(Cliente cliente)
    {
        clienteEliminar = cliente;

        mostrarModalEliminar = true;
    }


    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;

        clienteEliminar = null;
    }


    private async Task EliminarCliente()
    {
        if (clienteEliminar == null)
        {
            return;
        }

        try
        {
            eliminando = true;

            var resultado =
                await ClienteService.EliminarClienteAsync(
                    clienteEliminar.Id_cliente
                );

            if (resultado.Exito)
            {
                mostrarModalEliminar = false;
                clienteEliminar = null;

                await CargarClientes();

                MostrarMensaje(
                    resultado.Mensaje,
                    "alert-success"
                );
            }
            else
            {
                MostrarMensaje(
                    resultado.Mensaje,
                    "alert-danger"
                );
            }
        }
        catch (Exception ex)
        {
            MostrarMensaje(
                $"Error al eliminar: {ex.Message}",
                "alert-danger"
            );
        }
        finally
        {
            eliminando = false;
        }
    }


    private void MostrarMensaje(
        string texto,
        string clase
    )
    {
        mensaje = texto;

        claseMensaje = clase;
    }


    private void MostrarMensajeModal(
        string texto,
        string clase
    )
    {
        mensajeModal = texto;
        claseMensajeModal = clase;
    }

    private void CerrarMensajeModal()
    {
        mensajeModal = string.Empty;
    }

    private void CerrarMensaje()
    {
        mensaje = string.Empty;
    }
}